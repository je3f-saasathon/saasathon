# Copy to infra/langfuse/.env (scripts/langfuse.sh up does it and fills every blank secret
# with a random value). Never commit the real .env.

# Public URL the tunnel serves Langfuse on (login links and the SDK's LANGFUSE_HOST).
LANGFUSE_URL=https://langfuse.buggly.dev

# Host port for the UI + API (bound to 127.0.0.1 only; point the tunnel at it).
LANGFUSE_PORT=14420

# The UI login, created on first start. Sign-up is off: the UI is reachable from the internet.
LANGFUSE_ADMIN_EMAIL=admin@buggly.dev
LANGFUSE_ADMIN_PASSWORD=

# The "SRE agent" project's API keys, created on first start. The prod backend's .env.prod
# uses them as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY (the script adds the pk-lf-/sk-lf- prefix).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Session signing, hashing and encryption at rest. ENCRYPTION_KEY must be 64 hex characters.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=

# Internal store passwords (never exposed outside the compose network).
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
