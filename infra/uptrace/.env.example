# Copy to infra/uptrace/.env (scripts/uptrace.sh up does it and fills every blank secret
# with a random value). Never commit the real .env.

# Public URL the tunnel serves Uptrace on; used in links and in the DSN.
UPTRACE_SITE_URL=https://uptrace.buggly.dev

# Host ports (bound to 127.0.0.1 only).
UPTRACE_HTTP_PORT=14418
UPTRACE_GRPC_PORT=14417

# Signs sessions. Random, long.
UPTRACE_SECRET=

# The UI login. Pick a real password: the UI is reachable from the internet.
UPTRACE_ADMIN_EMAIL=admin@buggly.dev
UPTRACE_ADMIN_PASSWORD=

# User API token for the SRE worker's Uptrace credential (Authorization: Bearer ...).
UPTRACE_API_TOKEN=

# Project token apps send telemetry with. DSN: https://<token>@uptrace.buggly.dev?grpc=4317
UPTRACE_PROJECT_TOKEN=

# Internal database passwords (never exposed outside the compose network).
UPTRACE_CH_PASSWORD=
UPTRACE_PG_PASSWORD=
