# Copy to .env for production/tunnel deployment. Never commit the real .env.
# Values below are placeholders — every secret must be replaced.

BACKEND_PORT=8000

# Required: a strong, unique secret. Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

DEBUG=false

# Hosts this server will answer for (comma-separated).
ALLOWED_HOSTS=api.example.com

# Postgres in production.
DATABASE_URL=postgres://user:password@db:5432/backend

FRONTEND_URL=https://app.example.com

CORS_ALLOWED_ORIGINS=https://app.example.com

TOKEN_TTL_DAYS=30

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.example.com/api/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback
