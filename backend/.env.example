# Copy to .env for local (native) development. Never commit the real .env.

# Port the Django dev server binds to.
BACKEND_PORT=8000

# Django secret key. Generate a real one for anything beyond local dev:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=insecure-dev-secret-key-change-me

# true/false. Enables Django debug pages, the seed_demo_user command, etc.
DEBUG=true

# SQLite by default. Point at Postgres for docker/prod, e.g.:
#   postgres://user:password@localhost:5432/backend
DATABASE_URL=sqlite:///db.sqlite3

# Where the frontend is served from. Used to build OAuth redirect targets.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# How long an issued bearer token stays valid.
TOKEN_TTL_DAYS=30

# GitHub OAuth app credentials. Leave blank to disable GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Google OAuth client credentials. Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Cloudflare Workers AI credentials for the Jev integration. Leave blank to
# disable /api/jev/run. Requires gateway balance or BYOK on the Cloudflare
# account, or calls fail with a 402.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_JEV_MODEL=typesafe/jev
