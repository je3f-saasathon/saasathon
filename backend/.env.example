# Copy to .env for local (native) development. Never commit the real .env.

# Port the Django dev server binds to.
BACKEND_PORT=8000

# Django secret key. Generate a real one for anything beyond local dev:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=insecure-dev-secret-key-change-me

# true/false. Enables Django debug pages, the seed_demo_user command, etc.
DEBUG=true

# SQLite by default. Point at Postgres for docker/prod, e.g.:
#   postgres://user:password@localhost:5432/backend
DATABASE_URL=sqlite:///db.sqlite3

# Host port the docker-mode Postgres container publishes to. Only matters
# for docker mode (native mode uses SQLite); change it if 5432 is already
# taken on the host (e.g. a prod stack sharing the same machine).
DB_PORT=5432

# Where the frontend is served from. Used to build OAuth redirect targets.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# How long an issued bearer token stays valid.
TOKEN_TTL_DAYS=30

# GitHub OAuth app credentials. Leave blank to disable GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Google OAuth client credentials. Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Cloudflare Workers AI credentials for the Jev integration. Leave blank to
# disable /api/jev/run. Requires gateway balance or BYOK on the Cloudflare
# account, or calls fail with a 402. The SRE pipeline's jev_cloudflare model
# configs use these too, unless a config carries its own token/account_id.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_JEV_MODEL=typesafe/jev

# ---- SRE agent (Temporal workflow + LLM pipeline, see backend/sre/) ----

# Temporal server. `make infra-up` (or `make dev`) runs one via
# docker-compose.infra.yml on 7243 (7233 is left free for other projects).
TEMPORAL_ADDRESS=localhost:7243
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sre-pipeline

# Langfuse (tracing for the agent's LLM calls). The local infra stack
# bootstraps a project with exactly these keys, so they work out of the box.
# Blank keys disable tracing. For prod, point at your Langfuse and use real keys.
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev

# GitHub App the agent uses to clone, push and open PRs. Each SRE project
# stores its own installation id; these are the App's identity.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# The App's slug (github.com/apps/<slug>) and its OAuth Client ID / secret (App settings >
# General). Needed for "Connect GitHub" in /settings; see docs/AUTH.md. The App's
# Callback URL must be {backend}/api/sre/github/callback.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The App's webhook secret (App settings > General > Webhook). Its Webhook URL must be
# {backend}/api/sre/github/webhook with "Pull request" events on: merging a draft-only
# run's PR approves the fix, closing it unmerged rejects it. See docs/AUTH.md.
GITHUB_APP_WEBHOOK_SECRET=

# Encrypts users' LLM API keys at rest. Required. Generate (in backend/):
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SRE_FIELD_ENCRYPTION_KEY=

# Company default model, used by projects that haven't picked their own (billed to us).
# Triage runs on Jev (the CLOUDFLARE_* above) when configured, else the fast model;
# playbook writing/fixing uses the strong model. Blank key = no company default.
# The cap is tokens per project per calendar month on our keys (0 = unlimited).
SRE_PLATFORM_OPENAI_API_KEY=
SRE_PLATFORM_FAST_MODEL=gpt-5.4-mini
SRE_PLATFORM_STRONG_MODEL=gpt-5.5
SRE_PLATFORM_TRIAGE_USES_JEV=true
SRE_PLATFORM_MONTHLY_TOKEN_CAP=2000000

# Allow http:// and localhost/private-network LLM base_urls (e.g. a local
# Ollama at http://localhost:11434/v1). true for local dev only; keep false in
# prod, where it would let users point the worker at internal services.
SRE_ALLOW_PRIVATE_LLM_URLS=true
# Same for an Uptrace credential's api_base_url (a self-hosted Uptrace on localhost or a
# private network). Local dev only.
SRE_ALLOW_PRIVATE_UPTRACE_URLS=true

# Generic playbooks + per-project runbooks. false = the pipeline and playbook API
# behave exactly as before runbooks existed.
SRE_RUNBOOKS_ENABLED=false
# Managed Uptrace: set a token and every new project gets its own Uptrace project, error
# monitor and webhook channel, created by the platform, so users never log into Uptrace.
# UPTRACE_MANAGED_URL is Uptrace's public URL (alert links and DSNs); the API URL defaults
# to it. The token is an Uptrace user API token of an org admin (UPTRACE_API_TOKEN in
# infra/uptrace/.env for the self-hosted one). Empty = users connect Uptrace themselves.
UPTRACE_MANAGED_URL=
UPTRACE_MANAGED_API_URL=
UPTRACE_MANAGED_TOKEN=
UPTRACE_MANAGED_ORG_ID=
# Fetch the alert's exception/trace from the Uptrace API before triage (needs an
# Uptrace credential on the project's organization).
SRE_UPTRACE_FETCH_ENABLED=false
# Service mesh: org-wide service graph from Uptrace, root-cause trace walk, linked
# incidents across projects (docs/MESH_AND_REMEDIATION.md). Needs the Uptrace fetch on.
SRE_SERVICE_MESH_ENABLED=false
SRE_SERVICE_GRAPH_TTL_DAYS=7
SRE_MAX_NEIGHBOUR_REPOS=3
# Agent loop token savings: trim old tool results from the agent's history, and (when the
# project's triage runs on Jev) let Jev preload files, read failed command output, judge
# which old results to trim and stop an agent that's going in circles.
SRE_AGENT_COMPACT_HISTORY=true
SRE_AGENT_JEV_ASSIST=true
# With Jev assist: locate the bug's file, function, tests and test command up front.
SRE_AGENT_JEV_LOCALIZE=true
# Remediation agents: scan repos for bugs before they alert (docs/MESH_AND_REMEDIATION.md).
# on_merge / branch_watch need the GitHub App subscribed to Pull request + Push events.
SRE_REMEDIATION_AGENTS_ENABLED=false
# Open PRs (or PRs being written) per repo from remediation-agent findings; more get a diagnosis.
SRE_AGENT_MAX_OPEN_PRS_PER_REPO=3
# Installing the GitHub App creates a draft-only project for each repo it can reach (with
# managed Uptrace when it's configured), so `buggly run` works with no setup in the app.
SRE_GITHUB_AUTO_PROJECTS=false

# Sandbox the agent's commands run in (build: make sandbox-image). No network
# by default; set to bridge locally if a repo's tests must download deps.
SRE_SANDBOX_IMAGE=saasathon-sre-sandbox:latest
SRE_SANDBOX_NETWORK=none
# Network for the dependency-install step only (the sandbox is disconnected before the
# agent runs when SRE_SANDBOX_NETWORK=none). Set to none to block installs too.
SRE_SANDBOX_INSTALL_NETWORK=bridge

# Scratch dir for repo checkouts. In docker mode it must be the same path on
# the host and in the worker container, because the sandbox bind-mounts it.
SRE_WORKDIR=/tmp/sre-work

# Docker daemon the worker starts sandboxes on. Blank = local socket. In prod
# point at a docker:dind sidecar, not the host socket (host socket = root on host).
# DOCKER_HOST=tcp://docker:2376
