# Copy this file to scripts/tunnel.env and edit it (that file is gitignored).
#
# REMOTE_HOST must resolve via your own SSH config (~/.ssh/config) — set up
# a Host entry named "oma" (or change this to whatever alias/hostname you use)
# pointing at the machine that runs the dev/prod stack.
#
# Do NOT quote REMOTE_PROJECT_DIR. This file is parsed as plain text
# (grep/cut), not sourced by a shell, so quote characters become part of
# the literal value instead of being stripped. $HOME is left as literal
# text on purpose — it gets expanded by the REMOTE shell over ssh, once
# it's no longer wrapped in quotes that would suppress that expansion.
REMOTE_HOST=oma
REMOTE_PROJECT_DIR=$HOME/saasathon
REPO_URL=https://github.com/je3f-saasathon/saasathon.git
REMOTE_MODE=docker
