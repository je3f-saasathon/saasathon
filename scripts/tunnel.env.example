# Copy this file to scripts/tunnel.env and edit it (that file is gitignored).
#
# REMOTE_HOST must resolve via your own SSH config (~/.ssh/config) — set up
# a Host entry named "oma" (or change this to whatever alias/hostname you use)
# pointing at the machine that runs the dev/prod stack.
REMOTE_HOST=oma
REMOTE_PROJECT_DIR='$HOME/Je3f-saasathon'
REPO_URL=https://github.com/andples/Je3f-saasathon.git
REMOTE_MODE=docker
